# ── SERVIDOR ────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── BASE DE DADOS MySQL ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=enerconsult_user
DB_PASSWORD=SuaPasswordSegura123!
DB_NAME=enerconsult
DB_CONNECTION_LIMIT=10

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=mude_este_segredo_para_producao_min64chars!!
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── UPLOADS ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── LOGS ────────────────────────────────────────────
LOG_LEVEL=info
